# ====================================================================
# FC TOURNAMENT - VARIABLES D'ENVIRONNEMENT (DEVELOPPEMENT ET PRODUCTION)
# ====================================================================

# 1. Port du serveur HTTP (défaut: 3000 ou 8080 en dev)
PORT=3000

# 2. Code d'accès administrateur haute sécurité (requis pour l'espace admin)
# Ce code déverrouille l'espace administrateur sur le site en ligne et dans Google AI Studio.
# Valeurs acceptées par défaut: 96300130, FC_ADMIN_2026!, admin123
ADMIN_ACCESS_CODE=96300130

# 3. Base de données Supabase (Synchronisation permanente & Realtime)
# À renseigner sur votre hébergeur (Vercel > Project Settings > Environment Variables,
# ou sur Hostinger / Netlify / Render) :
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 4. Variables d'environnement frontend Vite (accessibles dans le navigateur)
# Permettent au formulaire d'inscrire directement les candidatures dans Supabase
# même si le serveur backend n'est pas actif (hébergement statique).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 5. Configuration SMTP (Envoi d'e-mails directs & invitations WhatsApp)
# Optionnel : si non configuré, le relais FormBold (alio227ng@gmail.com) prend le relais automatiquement.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=alio227ng@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="FC Tournament Staff" <alio227ng@gmail.com>

# 6. Clé API Gemini (si activée)
GEMINI_API_KEY=